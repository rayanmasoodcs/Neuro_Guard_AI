# NeuroGuard AI — Environment Configuration Template
# COPY THIS FILE to .env and fill in real values.
# NEVER commit .env to version control.
#
# Usage: rename this file to .env, set your actual values,
# then the backend will automatically load them via python-dotenv.

# ──────────────────────────────────────────────────────────
# FLASK SERVER
# ──────────────────────────────────────────────────────────
FLASK_ENV=development
# Set to 'production' on deployed servers. Controls debug mode.

FLASK_DEBUG=true
# Set to 'false' in production. Never expose Werkzeug debugger publicly.

FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# ──────────────────────────────────────────────────────────
# JWT AUTHENTICATION (server-signed tokens, pre-Firebase)
# ──────────────────────────────────────────────────────────
# REQUIRED: Set a strong, random secret for signing JWT tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(64))"
# NEVER commit a real value here. Keep this secret in .env only.
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_64_CHARS

# Token expiry in hours (default 24h).
JWT_EXPIRY_HOURS=24

# ──────────────────────────────────────────────────────────
# DATABASE — MySQL/MariaDB (primary)
# ──────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=neuroguard_ai

# ──────────────────────────────────────────────────────────
# DATABASE — SQLite fallback path (used when MySQL unavailable)
# ──────────────────────────────────────────────────────────
SQLITE_FALLBACK_PATH=neuroguard_ai_fallback.db

# ──────────────────────────────────────────────────────────
# CORS — Allowed origins (comma-separated)
# ──────────────────────────────────────────────────────────
# In production, list exact Flutter web / dashboard origins only.
# Example: CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
CORS_ORIGINS=*

# ──────────────────────────────────────────────────────────
# ML MODEL DIRECTORY
# ──────────────────────────────────────────────────────────
ML_MODEL_DIR=./ml_models

# ──────────────────────────────────────────────────────────
# NOTIFICATION SCHEDULER
# ──────────────────────────────────────────────────────────
SCHEDULER_INTERVAL_SECONDS=300

# ──────────────────────────────────────────────────────────
# FILE UPLOAD LIMITS
# ──────────────────────────────────────────────────────────
# Maximum HTTP payload in bytes (50MB default)
MAX_CONTENT_LENGTH=52428800

# ──────────────────────────────────────────────────────────
# FUTURE: Firebase Service Account (do NOT commit)
# ──────────────────────────────────────────────────────────
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase_credentials.json
# FIREBASE_PROJECT_ID=your-firebase-project-id

# ──────────────────────────────────────────────────────────
# FUTURE: Twilio Emergency SMS (do NOT commit)
# ──────────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

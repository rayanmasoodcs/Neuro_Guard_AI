**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ──────────────────────────────────────────────────────────
# PYTHON BACKEND
# ──────────────────────────────────────────────────────────

# Environment secrets — NEVER commit real .env
.env
.env.local
.env.production

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/
.env/

# ──────────────────────────────────────────────────────────
# DATABASE BINARIES
# ──────────────────────────────────────────────────────────
# SQLite fallback database — contains patient data; track via backup, not VCS
*.db
*.sqlite
*.sqlite3

# ──────────────────────────────────────────────────────────
# ML MODEL ARTIFACTS
# ──────────────────────────────────────────────────────────
# Binary model artifacts must be versioned via MLflow / DVC, not Git
*.joblib
*.pkl

# ──────────────────────────────────────────────────────────
# BACKEND REPORT DUMPS
# ──────────────────────────────────────────────────────────
# Auto-generated analysis report JSON files
report.*.json

# ──────────────────────────────────────────────────────────
# FIREBASE CREDENTIALS (future)
# ──────────────────────────────────────────────────────────
firebase_credentials.json
google-services.json
GoogleService-Info.plist
serviceAccountKey.json

# Node dependencies (run `npm install` in backend/)
node_modules/

# Downloaded EEG datasets (get them with ml_models/training/01_download_chbmit.py)
data/chbmit/chb*/
data/chbmit/seizure_files.txt
*.edf.part

# Dev config is committed on purpose; it must never contain real cloud credentials (public repo)
!backend/.env
!ml_models/seizure_eeg_model.joblib
